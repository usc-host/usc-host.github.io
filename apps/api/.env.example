# Variáveis lidas pela API. No Render, cadastre em Environment.
# Em desenvolvimento, use user-secrets (não versionado):
#   dotnet user-secrets set GEMINI_API_KEY "sua-chave" --project apps/api/src/BellaMassa.Api

# Chave do Google AI Studio. Sem ela o assistente roda em modo local (só fora de produção).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelo tentado só depois de falhas temporárias do principal. Opcional.
GEMINI_FALLBACK_MODEL=
# minimal, low, medium ou high. Deixe vazio para modelos sem esse controle.
GEMINI_THINKING_LEVEL=low
GEMINI_RETRIES=2
GEMINI_TIMEOUT_MS=25000

# gemini (padrão quando há chave), local ou off
ASSISTANT_MODE=

# Origens autorizadas a chamar a API, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://usc-host.github.io

# Limites
CHAT_MAX_MESSAGE_CHARS=600
CHAT_MAX_HISTORY=16
CHAT_MAX_HISTORY_CHARS=8000
CHAT_MAX_TOOL_CALLS=6
CHAT_TURN_TIMEOUT_MS=60000
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_DAY=150
QUOTES_RATE_PER_MINUTE=60
